# Copy to .env and fill in. The npm scripts load this file automatically when it exists,
# so every setting is optional - the server runs without it.
# Without SMTP settings the API still saves every submission; it just cannot email yet.

# --- Email delivery (SMTP) ---
# Any SMTP provider works. Examples:
#   Standard mail host : SMTP_HOST=mail.avantehospitality.co.za  SMTP_PORT=587
#   Gmail              : SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (needs an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Addresses the site emails
MAIL_FROM="Avante Website <no-reply@avantehospitality.co.za>"
MAIL_TO=info@avantehospitality.co.za
MAIL_CC=admin@avantehospitality.co.za,liason@avantehospitality.co.za

# --- Server ---
PORT=3000

# --- Admin page (view and export submissions) ---
# The /admin page is DISABLED until this is set. Use a long, unique password.
ADMIN_PASSWORD=
# Optional: signs the admin session cookie. Defaults to ADMIN_PASSWORD.
# Changing it logs everybody out.
ADMIN_SESSION_SECRET=

# Where submissions.sqlite is written. Point this at a persistent disk when deployed.
DATA_DIR=./data

# Allowed origin for the API. Leave * unless the static site is hosted separately.
CORS_ORIGIN=*

# How long form submissions are kept before `npm run submissions -- --prune` removes them (days)
RETENTION_DAYS=730
