  :root{
    --ink:#0B1F22;
    --ink-soft:#132C2F;
    --ivory:#FBF7EF;
    --ivory-dim:#F3EDE0;
    --teal:#0DCDC2;
    --teal-deep:#08757A;
    --sand:#C9A15A;
    --text:#14231F;
    --text-soft:#4C5C58;
    --line:rgba(20,35,31,0.12);
    --line-light:rgba(251,247,239,0.16);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    color:var(--text);
    background:var(--ivory);
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Fraunces',serif;
    font-weight:500;
    margin:0;
    letter-spacing:-0.01em;
  }
  p{margin:0;}
  a{color:inherit;}
  .wrap{max-width:760px; margin:0 auto; padding:0 32px;}
  @media (max-width:640px){ .wrap{padding:0 20px;} }

  /* ---------- HEADER ---------- */
  header.top{
    background:var(--ink);
    color:var(--ivory);
    padding:26px 0;
  }
  header.top .wrap{
    display:flex; align-items:center; justify-content:space-between;
    max-width:900px;
  }
  .brand{
    font-family:'Fraunces',serif;
    font-size:20px;
    letter-spacing:0.02em;
    color:var(--ivory);
    text-decoration:none;
  }
  .brand span{color:var(--teal);}
  .back-link{
    font-size:14px;
    color:rgba(251,247,239,0.72);
    text-decoration:none;
  }
  .back-link:hover{color:var(--ivory);}

  /* ---------- FORM CARD ---------- */
  main{padding:56px 0 80px;}
  .form-card{
    max-width:900px;
    margin:0 auto;
    background:#fff;
    border:1px solid var(--line);
    border-radius:6px;
    padding:44px 48px;
  }
  @media (max-width:640px){ .form-card{padding:30px 22px;} }

  .eyebrow-line{
    display:flex; align-items:center; gap:10px;
    margin-bottom:18px; font-size:14px; color:var(--teal-deep);
  }
  .eyebrow-line .dash{width:28px; height:1px; background:var(--teal-deep);}

  .form-card h1{font-size:clamp(28px,4vw,36px); line-height:1.12; margin-bottom:14px;}
  .form-card .lead{font-size:16px; color:var(--text-soft); line-height:1.6; max-width:560px; margin-bottom:36px;}

  .field-grid{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  .field-grid.single{grid-template-columns:1fr;}
  @media (max-width:640px){ .field-grid{grid-template-columns:1fr;} }

  .field{margin-bottom:22px;}
  .field label{
    display:block; font-size:13.5px; font-weight:600; color:var(--text);
    margin-bottom:7px;
  }
  .field input, .field select{
    width:100%;
    padding:11px 14px;
    font-family:'Inter',sans-serif;
    font-size:15px;
    color:var(--text);
    background:var(--ivory-dim);
    border:1px solid var(--line);
    border-radius:4px;
  }
  .field input:focus, .field select:focus{
    outline:none;
    border-color:var(--teal-deep);
    box-shadow:0 0 0 3px rgba(13,205,194,0.18);
  }

  .terms-box{
    display:flex; align-items:flex-start; gap:12px;
    padding:16px 18px;
    background:var(--ivory-dim);
    border:1px solid var(--line);
    border-radius:6px;
    margin:8px 0 30px;
  }
  .terms-box input{margin-top:3px; accent-color:var(--teal-deep); width:17px; height:17px;}
  .terms-box label{font-size:14px; color:var(--text); cursor:pointer;}
  .terms-box button{
    display:block; margin-top:4px;
    background:none; border:none; padding:0;
    font-size:13.5px; font-weight:600; color:var(--teal-deep);
    text-decoration:underline; cursor:pointer;
  }

  .btn-primary{
    display:inline-flex; align-items:center; gap:10px;
    background:var(--teal); color:var(--ink);
    font-weight:600; font-size:15px;
    padding:15px 30px;
    border:none; border-radius:3px;
    cursor:pointer;
    transition:transform 0.15s ease;
  }
  .btn-primary:hover{transform:translateY(-1px);}
  .btn-primary:disabled{opacity:0.6; cursor:not-allowed; transform:none;}

  .submit-row{text-align:center; padding-top:8px; border-top:1px solid var(--line);}
  .submit-note{margin-top:18px; font-size:13.5px; color:var(--text-soft);}
  .submit-note a{color:var(--teal-deep); font-weight:600; text-decoration:underline;}

  #error-message{display:none; margin-top:16px; font-size:14px; color:#B3261E;}

  /* ---------- SUCCESS STATE ---------- */
  #success-message{display:none; opacity:0; transition:opacity 0.5s ease-in-out;}
  .success-panel{
    text-align:center; padding:34px 28px;
    background:#EAF9F3; border:1px solid #B9E8D5; border-radius:6px;
    color:#0F4D3A;
  }
  .success-panel h3{font-size:22px; margin-bottom:8px;}
  .success-panel p{font-size:15px;}

  /* ---------- MODAL ---------- */
  .modal-overlay{
    display:none; position:fixed; inset:0;
    background:rgba(11,31,34,0.6);
    z-index:50; align-items:center; justify-content:center; padding:20px;
  }
  .modal-box{
    background:#fff; border-radius:8px;
    max-width:600px; width:100%; max-height:80vh;
    display:flex; flex-direction:column;
  }
  .modal-head{
    padding:20px 26px; border-bottom:1px solid var(--line);
    display:flex; align-items:center; justify-content:space-between;
  }
  .modal-head h3{font-size:19px;}
  .modal-head button{background:none; border:none; font-size:26px; line-height:1; color:var(--text-soft); cursor:pointer;}
  .modal-body{padding:20px 26px; overflow-y:auto; font-size:14px; color:var(--text-soft); line-height:1.6;}
  .modal-body p{margin-bottom:12px;}
  .modal-body .draft-tag{font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--sand); margin-bottom:10px;}
  .modal-foot{padding:16px 26px; border-top:1px solid var(--line); text-align:right;}
  .modal-foot button{
    background:var(--teal); color:var(--ink); font-weight:600; font-size:14px;
    padding:10px 22px; border:none; border-radius:3px; cursor:pointer;
  }