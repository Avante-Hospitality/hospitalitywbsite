{# A page that only forwards old links and QR codes to where the page lives
   now (Jean, 2026-10-19): the "List your property" form, the Terms &
   Conditions and the property affiliate application all live on the Avante
   hub, so there is one copy to keep up to date. Front matter: title,
   forwardTo (the address), forwardLabel (the link text). #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ forwardTo }}">
<meta http-equiv="refresh" content="0; url={{ forwardTo }}">
<script>location.replace({{ forwardTo | dump | safe }});</script>
<style>body{margin:0;font-family:system-ui,sans-serif;background:#f7f6f2;color:#1f2633;display:flex;min-height:100vh;align-items:center;justify-content:center;padding:16px;text-align:center}a{color:#1e2bb8}</style>
</head>
<body>
<p>Taking you there… If nothing happens, <a href="{{ forwardTo }}">{{ forwardLabel }}</a>.</p>
</body>
</html>
