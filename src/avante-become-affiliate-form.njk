---
layout: layouts/avante-form.njk
title: "Avante Travel — Become an Affiliate"
permalink: /avante-become-affiliate-form.html
commentFile: "avante/comment-become-affiliate-form.njk"
styleFile: "avante/style-become-affiliate-form.njk"
backHref: "avante-affiliate-landing.html"
backLabel: "&larr; Back to affiliate program"
---
{% include "avante/form-header.njk" %}

<main>
  <div class="wrap">
    <div class="form-card">

      <img src="img/logo-icon.png" alt="Avante Hospitality" style="height:36px; width:auto; margin-bottom:20px;">
      <div class="eyebrow-line"><span class="dash"></span> Affiliate Application</div>
      <h1>Become an Affiliate</h1>
      <p class="lead">Tell us a bit about yourself and where you're based — applications are reviewed by Avante Travel before Hub access goes live.</p>

      <form id="affiliate-form">
        <div class="field-grid">
          <div class="field">
            <label for="full-name">Full Name</label>
            <input type="text" id="full-name" name="full_name" required>
          </div>
          <div class="field">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="field">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" required>
          </div>
          <div class="field">
            <label for="residence-city">Current City / Town</label>
            <input type="text" id="residence-city" name="residence_city" required>
          </div>
          <div class="field">
            <label for="residence-country">Country of Residence</label>
            <input type="text" id="residence-country" name="residence_country" required>
          </div>
          <div class="field">
            <label for="promote-via">How do you plan to promote Avante?</label>
            <select id="promote-via" name="promote_via" required>
              <option value="" disabled selected>Select an option</option>
              <option value="Social media">Social media</option>
              <option value="Blog or website">Blog or website</option>
              <option value="Personal network">Personal network</option>
              <option value="Travel agency">Travel agency</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="social-link">Website or social profile link (optional)</label>
          <input type="text" id="social-link" name="social_link" placeholder="e.g. instagram.com/yourhandle">
        </div>

        <div class="terms-box">
          <input type="checkbox" id="accept-terms" name="accept_terms" checked required>
          <div>
            <label for="accept-terms">I accept the Avante Travel Affiliate Terms &amp; Conditions.</label>
            <button type="button" id="open-terms">View Terms &amp; Conditions</button>
          </div>
        </div>

        <div class="submit-row">
          <button type="submit" id="submit-btn" class="btn-primary">Submit Application &rarr;</button>
          <p id="error-message"></p>
          <p class="submit-note">Questions? Email <a href="mailto:info@avantetravel.co.za">info@avantetravel.co.za</a></p>
        </div>
      </form>

      <div id="success-message">
        <div class="success-panel">
          <h3>Thank you!</h3>
          <p>Your application has been sent to Avante Travel. We'll review it and be in touch about Hub access shortly.</p>
        </div>
      </div>

    </div>
  </div>
</main>

<!-- Terms & Conditions Modal -->
<div id="terms-modal" class="modal-overlay">
  <div class="modal-box">
    <div class="modal-head">
      <h3>Affiliate Terms &amp; Conditions</h3>
      <button type="button" id="close-terms" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <!-- PLACEHOLDER T&C TEXT — Jean to replace with the final, approved wording. -->
      <p class="draft-tag">Draft placeholder — not final legal text</p>
      <p>By applying to the Avante Travel affiliate program, you agree that any bookings driven through your unique link will be tracked via Avante's booking engine and reconciled through Impact.com, and that commission is paid according to the affiliate agreement provided upon approval.</p>
      <p>Approval is at Avante Travel's discretion. Submitting this form does not guarantee Hub access — applications are reviewed before any affiliate link or dashboard is issued.</p>
      <p><em>[Final Terms &amp; Conditions text to be supplied by Avante Travel.]</em></p>
    </div>
    <div class="modal-foot">
      <button type="button" id="acknowledge-terms">Close</button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Submissions are saved to SQLite and emailed by the API in server/.
    // If the API is hosted on a different domain, set API_BASE to its URL.
    const API_BASE = '';
    const SUBMIT_ENDPOINT = API_BASE + '/api/submissions/affiliate';

    const form = document.getElementById('affiliate-form');
    const submitBtn = document.getElementById('submit-btn');
    const errorMessage = document.getElementById('error-message');
    const successMessage = document.getElementById('success-message');

    // Terms modal
    const termsModal = document.getElementById('terms-modal');
    document.getElementById('open-terms').addEventListener('click', () => termsModal.style.display = 'flex');
    document.getElementById('close-terms').addEventListener('click', () => termsModal.style.display = 'none');
    document.getElementById('acknowledge-terms').addEventListener('click', () => termsModal.style.display = 'none');

    form.addEventListener('submit', async function (event) {
        event.preventDefault();
        errorMessage.style.display = 'none';

        const fullName = document.getElementById('full-name').value;
        const city = document.getElementById('residence-city').value;
        const country = document.getElementById('residence-country').value;

        const payload = {
            full_name: fullName,
            email: document.getElementById('email').value,
            phone: document.getElementById('phone').value,
            residence_city: city,
            residence_country: country,
            promote_via: document.getElementById('promote-via').value,
            social_link: document.getElementById('social-link').value,
            accept_terms: document.getElementById('accept-terms').checked
        };

        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting…';

        try {
            const response = await fetch(SUBMIT_ENDPOINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (response.ok) {
                form.style.display = 'none';
                successMessage.style.display = 'block';
                setTimeout(() => successMessage.style.opacity = '1', 10);
            } else {
                throw new Error('Submission failed');
            }
        } catch (err) {
            errorMessage.textContent = 'Something went wrong sending your application. Please try again or email info@avantetravel.co.za directly.';
            errorMessage.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Application →';
        }
    });
});
</script>

