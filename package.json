{
  "name": "avante-hospitality-website",
  "version": "1.0.0",
  "private": true,
  "description": "Avante Hospitality marketing website (Eleventy)",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "api": "node server/index.js",
    "dev": "node --watch server/index.js",
    "start": "npm run build && node server/index.js",
    "submissions": "node server/submissions.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.16"
  }
}
